APP_NAME=AlphaLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alphalink
DB_USERNAME=alphalink
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=
# Stable, dedicated HMAC key for private contact lookup; use at least 32 random bytes.
CONTACT_LOOKUP_KEY=
CONTACT_LOOKUP_KEY_VERSION=1
PMTA_BUNDLE_DIR=
# Ubuntu deployment stores licensed, reviewed PMTA assets in private shared storage.
ALPHALINK_INSTALL_ASSETS_DIRECTORY=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
HORIZON_AUTHORIZED_EMAILS=
# Local development fallback only; the Ubuntu 26 production installer derives these from the server.
HORIZON_MAX_PROCESSES=2
AUDIENCE_IMPORT_MAX_PROCESSES=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

INFRASTRUCTURE_PMTA_PORT=1212
INFRASTRUCTURE_PROBE_TIMEOUT_SECONDS=10
INFRASTRUCTURE_IP_API_KEY=
INFRASTRUCTURE_MAXMIND_CITY_DATABASE=
INFRASTRUCTURE_BULK_INSTALL_ASSETS_DIRECTORY=
ALPHALINK_TRACKING_CALLBACK_URL=
ALPHALINK_INSTALL_PMTA_RELAY_IPS=

# Remote installation commands are fail-closed until explicitly enabled.
ALPHALINK_SINGLE_INSTALL_EXECUTION_ENABLED=false
ALPHALINK_INSTALL_EXECUTION_ENABLED=false
ALPHALINK_REINSTALL_EXECUTION_ENABLED=false
ALPHALINK_REINSTALL_IP_CONFIG_EXECUTION_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
